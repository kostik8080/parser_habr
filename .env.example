# Ключи доступа к Supabase. Не коммитить — файл в .gitignore.
# Скопируйте в .env и заполните значениями из панели Supabase:
# Project Settings -> API.

# Адрес REST API Supabase (Project Settings -> API -> Project URL)
SUPABASE_URL=

# Ключ уровня "service_role" (Project Settings -> API -> service_role)
# Внимание: этот ключ даёт полный доступ к базе. Храните его только в .env.
SUPABASE_SERVICE_ROLE_KEY=
